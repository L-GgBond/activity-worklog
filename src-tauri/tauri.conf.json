{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Activity Worklog",
  "version": "0.2.0",
  "identifier": "com.local.activity-worklog",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Activity Worklog",
        "width": 1400,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "visible": true,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OWNER/activity-worklog/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MjcyMEExOEQzQTA4QUYKUldTdkNEcU5vU0FubDZJWEh4MGpvZDZKUXVNM24wY3dwS2VQaWYvSmxTVktPYTZrWVhpMjMza1oK"
    }
  }
}
